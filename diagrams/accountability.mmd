flowchart TD
  RAISE_ISSUE[Other side raises an issue]
  SELF_LISTEN["Me: Listen"]
  SELF_TAKE_NOTES["Me: take notes"]

  Q_THEM_DONE_SPEAKING{"in my head: are they done speaking"?}
  Q_THEM_DONE_SPEAKING_Y[Yes]
  Q_THEM_DONE_SPEAKING_N[No]

  Q_ANYTHING_I_DO_NOT_UNDERSTAND{"in my head: is there anything said that I don't understand?"}
  Q_ANYTHING_I_DO_NOT_UNDERSTAND_Y[Yes]
  Q_ANYTHING_I_DO_NOT_UNDERSTAND_N[No]

  Q_CLARIFY_ISSUE_COUNT{"how many times have I asked them to clarify ___?"}
  Q_CLARIFY_ISSUE_COUNT_ONCE[Once]
  Q_CLARIFY_ISSUE_COUNT_NONE[I haven't yet]
  Q_CLARIFY_ISSUE_COUNT_MULTIPLE["more than once"]

  SELF_ASK_CLARIFYING_QUESTIONS["ask them: I want to understand ___ better. <br/> Can you say more?"]
  Q_SAY_MORE_TO_CLARIFY{"did they agree to say more?"}
  Q_SAY_MORE_TO_CLARIFY_Y[Yes]
  Q_SAY_MORE_TO_CLARIFY_N[No]

  SELF_ASK_PAUSE["ask them: 'Can we pause? I need time to think about this on my own.'"]
  SELF_PAUSE_REFLECT["Me: (alone) reflect on my notes and how my actions affected them"]
  Q_PAUSE_UNDERSTAND_AND_EMPATHY{"Me: ask self 'Do I understand their issue and feel genuine empathy?'"}
  Q_PAUSE_UNDERSTAND_AND_EMPATHY_Y[Yes]
  Q_PAUSE_UNDERSTAND_AND_EMPATHY_N[No]

  Q_PAUSE_REFLECT_COUNT{"how many times have I reflected alone?"}
  Q_PAUSE_REFLECT_COUNT_ONCE[Once]
  Q_PAUSE_REFLECT_COUNT_MULTIPLE["more than once"]

  SELF_REFLECT_ON_ISSUE["Me: (in my head) reflect on what they said on my notes"]

  Q_INTERNAL_UNDERSTANDING{"Me: ask self 'Do I understand their issue enough to restate it to them'?"}
  Q_INTERNAL_UNDERSTANDING_Y[Yes]
  Q_INTERNAL_UNDERSTANDING_N[No]

  SELF_RESTATE_ISSUE["Me: read notes to them for confirmation of understanding"]
  
  Q_UNDERSTANDING_ISSUE{"Me: ask them: 'Is my understanding correct?'"}
  Q_UNDERSTANDING_ISSUE_Y[Yes]
  Q_UNDERSTANDING_ISSUE_N[No]
  
  SELF_CHECK_EMPATHY_GOAL[Me: Goal: Empathy]
  
  Q_FEELING_EMPATHY{"Me: ask self 'Do I feel genuine empathy?'"}
  Q_FEELING_EMPATHY_Y[Yes]
  Q_FEELING_EMPATHY_N[No]
  
  SELF_LACK_EMPATHY_ASK["Me: ask them for an impact statement"]
  
  Q_THEIR_IMPACT_STATEMENT{"Did they provide an impact statement"}
  Q_THEIR_IMPACT_STATEMENT_Y[Yes]
  Q_THEIR_IMPACT_STATEMENT_N[No]
  
  SELF_CREATE_SYNTHETIC_IMPACT_STATEMENT["self: draft my own impact statement of what they felt"]
  
  Q_SYNTHETIC_IMPACT_STATEMENT_SHARE{"Me: ask them: 'can I share how I think you felt?'"}
  Q_SYNTHETIC_IMPACT_STATEMENT_SHARE_Y[Yes]
  Q_SYNTHETIC_IMPACT_STATEMENT_SHARE_N[No]
  
  Q_SYNTHETIC_IMPACT_STATEMENT_ACCURACY{"Me: ask them 'Is my understanding of how you felt accurate'?"}
  Q_SYNTHETIC_IMPACT_STATEMENT_ACCURACY_Y[Yes]
  Q_SYNTHETIC_IMPACT_STATEMENT_ACCURACY_N[No]

  Q_SYNTHETIC_IMPACT_STATEMENT_COUNT{"how many times have I drafted an impact statement?"}
  Q_SYNTHETIC_IMPACT_STATEMENT_COUNT_ONCE[Once]
  Q_SYNTHETIC_IMPACT_STATEMENT_COUNT_MULTIPLE["more than once"]
  
  SELF_CHECK_IMPACT_GOAL[Me: Goal: Understand Impact]
  Q_UNDERSTAND_IMPACT{"Me: ask self 'Do I understand the hurt caused?'"}
  Q_UNDERSTAND_IMPACT_Y[Yes]
  Q_UNDERSTAND_IMPACT_N[No]
  SELF_REFLECT_ON_IMPACT["Me: reflect on their impact statement if I have it, or on my notes"]

  SELF_CHECK_REGRET_GOAL[Me: Goal: Feel Regret]
  
  Q_FEELING_REGRET{"Me: ask self 'Do I feel genuine regret?'"}
  Q_FEELING_REGRET_Y[Yes]
  Q_FEELING_REGRET_N[No]
  
  SELF_SPOT_MY_PATTERNS[Me: Goal: Self-awareness]
  Q_UNDERSTAND_PATTERNS{"Me: ask self 'Do I understand my patterns?'"}
  Q_UNDERSTAND_PATTERNS_Y[Yes]
  Q_UNDERSTAND_PATTERNS_N[No]
  SELF_REFLECT_ON_PAST_TIMES["Me: reflect on past times this happened"]
  SELF_CHECK_CHANGE_GOAL[Me: Goal: Changed behavior]
  SELF_FIND_NEW_PATTERN["(in my head)What am I going to do differently"]
  Q_KNOW_NEW_PATTERN{"Me: ask self 'Do I know what I'll do differently?'"}
  Q_KNOW_NEW_PATTERN_Y[Yes]
  Q_KNOW_NEW_PATTERN_N[No]
  SELF_EXPRESS_NEW_PATTERN["Communicate: 'here is what I am going to do differently"]
  SELF_CHECK_FOLLOW_UP_GOAL[Me: Goal: Follow-up]
  SELF_FOLLOW_UP["(in the future) ask them: 'Hey, I wanted to check in about ___'"]

RAISE_ISSUE --> SELF_LISTEN --> SELF_TAKE_NOTES --> Q_THEM_DONE_SPEAKING
Q_THEM_DONE_SPEAKING --> Q_THEM_DONE_SPEAKING_Y --> Q_ANYTHING_I_DO_NOT_UNDERSTAND
Q_THEM_DONE_SPEAKING --> Q_THEM_DONE_SPEAKING_N --> SELF_LISTEN

Q_ANYTHING_I_DO_NOT_UNDERSTAND --> Q_ANYTHING_I_DO_NOT_UNDERSTAND_Y --> Q_CLARIFY_ISSUE_COUNT
Q_CLARIFY_ISSUE_COUNT --> Q_CLARIFY_ISSUE_COUNT_NONE --> SELF_ASK_CLARIFYING_QUESTIONS
Q_CLARIFY_ISSUE_COUNT --> Q_CLARIFY_ISSUE_COUNT_ONCE --> SELF_ASK_CLARIFYING_QUESTIONS
Q_CLARIFY_ISSUE_COUNT --> Q_CLARIFY_ISSUE_COUNT_MULTIPLE --> SELF_ASK_PAUSE

SELF_ASK_PAUSE --> SELF_PAUSE_REFLECT --> Q_PAUSE_UNDERSTAND_AND_EMPATHY
Q_PAUSE_UNDERSTAND_AND_EMPATHY --> Q_PAUSE_UNDERSTAND_AND_EMPATHY_Y --> SELF_RESTATE_ISSUE
Q_PAUSE_UNDERSTAND_AND_EMPATHY --> Q_PAUSE_UNDERSTAND_AND_EMPATHY_N --> Q_PAUSE_REFLECT_COUNT
Q_PAUSE_REFLECT_COUNT --> Q_PAUSE_REFLECT_COUNT_ONCE --> SELF_LACK_EMPATHY_ASK
Q_PAUSE_REFLECT_COUNT --> Q_PAUSE_REFLECT_COUNT_MULTIPLE --> SELF_CHECK_EMPATHY_GOAL

Q_ANYTHING_I_DO_NOT_UNDERSTAND --> Q_ANYTHING_I_DO_NOT_UNDERSTAND_N --> SELF_REFLECT_ON_ISSUE

Q_INTERNAL_UNDERSTANDING --> Q_INTERNAL_UNDERSTANDING_Y --> SELF_RESTATE_ISSUE
Q_INTERNAL_UNDERSTANDING --> Q_INTERNAL_UNDERSTANDING_N --> Q_CLARIFY_ISSUE_COUNT

SELF_ASK_CLARIFYING_QUESTIONS --> Q_SAY_MORE_TO_CLARIFY
Q_SAY_MORE_TO_CLARIFY --> Q_SAY_MORE_TO_CLARIFY_Y --> SELF_LISTEN
Q_SAY_MORE_TO_CLARIFY --> Q_SAY_MORE_TO_CLARIFY_N --> SELF_REFLECT_ON_ISSUE

SELF_REFLECT_ON_ISSUE --> Q_INTERNAL_UNDERSTANDING

SELF_RESTATE_ISSUE --> Q_UNDERSTANDING_ISSUE
Q_UNDERSTANDING_ISSUE --> Q_UNDERSTANDING_ISSUE_Y --> SELF_CHECK_EMPATHY_GOAL
Q_UNDERSTANDING_ISSUE --> Q_UNDERSTANDING_ISSUE_N --> Q_CLARIFY_ISSUE_COUNT

SELF_CHECK_EMPATHY_GOAL --> Q_FEELING_EMPATHY 
Q_FEELING_EMPATHY --> Q_FEELING_EMPATHY_Y --> SELF_CHECK_IMPACT_GOAL
Q_FEELING_EMPATHY --> Q_FEELING_EMPATHY_N --> SELF_LACK_EMPATHY_ASK

SELF_LACK_EMPATHY_ASK --> Q_THEIR_IMPACT_STATEMENT
Q_THEIR_IMPACT_STATEMENT --> Q_THEIR_IMPACT_STATEMENT_Y --> SELF_CHECK_REGRET_GOAL
Q_THEIR_IMPACT_STATEMENT --> Q_THEIR_IMPACT_STATEMENT_N --> SELF_CREATE_SYNTHETIC_IMPACT_STATEMENT

SELF_CREATE_SYNTHETIC_IMPACT_STATEMENT --> Q_SYNTHETIC_IMPACT_STATEMENT_SHARE
Q_SYNTHETIC_IMPACT_STATEMENT_SHARE --> Q_SYNTHETIC_IMPACT_STATEMENT_SHARE_Y --> Q_SYNTHETIC_IMPACT_STATEMENT_ACCURACY
Q_SYNTHETIC_IMPACT_STATEMENT_SHARE --> Q_SYNTHETIC_IMPACT_STATEMENT_SHARE_N --> SELF_CHECK_REGRET_GOAL

Q_SYNTHETIC_IMPACT_STATEMENT_ACCURACY --> Q_SYNTHETIC_IMPACT_STATEMENT_ACCURACY_Y --> SELF_CHECK_REGRET_GOAL
Q_SYNTHETIC_IMPACT_STATEMENT_ACCURACY --> Q_SYNTHETIC_IMPACT_STATEMENT_ACCURACY_N --> Q_SYNTHETIC_IMPACT_STATEMENT_COUNT
Q_SYNTHETIC_IMPACT_STATEMENT_COUNT --> Q_SYNTHETIC_IMPACT_STATEMENT_COUNT_ONCE --> SELF_CREATE_SYNTHETIC_IMPACT_STATEMENT
Q_SYNTHETIC_IMPACT_STATEMENT_COUNT --> Q_SYNTHETIC_IMPACT_STATEMENT_COUNT_MULTIPLE --> SELF_CHECK_EMPATHY_GOAL

%% SELF_CHECK_EMPATHY_GOAL
%% SELF_CHECK_EMPATHY_GOAL --> Q_FEELING_REGRET
%% SELF_CHECK_EMPATHY_GOAL --> SELF_SPOT_MY_PATTERNS

SELF_CHECK_IMPACT_GOAL --> Q_UNDERSTAND_IMPACT
Q_UNDERSTAND_IMPACT --> Q_UNDERSTAND_IMPACT_Y --> SELF_CHECK_REGRET_GOAL
Q_UNDERSTAND_IMPACT --> Q_UNDERSTAND_IMPACT_N --> SELF_REFLECT_ON_IMPACT --> Q_UNDERSTAND_IMPACT
SELF_CHECK_REGRET_GOAL --> Q_FEELING_REGRET
Q_FEELING_REGRET --> Q_FEELING_REGRET_Y --> SELF_SPOT_MY_PATTERNS
Q_FEELING_REGRET --> Q_FEELING_REGRET_N --> SELF_CHECK_EMPATHY_GOAL

SELF_SPOT_MY_PATTERNS --> Q_UNDERSTAND_PATTERNS
Q_UNDERSTAND_PATTERNS --> Q_UNDERSTAND_PATTERNS_Y --> SELF_CHECK_CHANGE_GOAL
Q_UNDERSTAND_PATTERNS --> Q_UNDERSTAND_PATTERNS_N --> SELF_REFLECT_ON_PAST_TIMES --> Q_UNDERSTAND_PATTERNS

SELF_CHECK_CHANGE_GOAL --> SELF_FIND_NEW_PATTERN --> Q_KNOW_NEW_PATTERN
Q_KNOW_NEW_PATTERN --> Q_KNOW_NEW_PATTERN_Y --> SELF_EXPRESS_NEW_PATTERN
Q_KNOW_NEW_PATTERN --> Q_KNOW_NEW_PATTERN_N --> SELF_SPOT_MY_PATTERNS

SELF_EXPRESS_NEW_PATTERN --> SELF_CHECK_FOLLOW_UP_GOAL --> SELF_FOLLOW_UP

%% colors: goal = green, forwards = green, decision = yellow, answer that goes backwards = red
classDef forwards fill:#c8f7c5,stroke:#2e7d32
classDef goal fill:#c8f7c5,stroke:#2e7d32
classDef decision fill:#fff3b0,stroke:#b8860b
classDef backwards fill:#f8c8c8,stroke:#c62828

class SELF_CHECK_EMPATHY_GOAL,SELF_CHECK_IMPACT_GOAL,SELF_CHECK_REGRET_GOAL,SELF_SPOT_MY_PATTERNS,SELF_CHECK_CHANGE_GOAL,SELF_CHECK_FOLLOW_UP_GOAL goal
class RAISE_ISSUE,SELF_LISTEN,SELF_TAKE_NOTES,Q_THEM_DONE_SPEAKING_Y,Q_ANYTHING_I_DO_NOT_UNDERSTAND_N,Q_CLARIFY_ISSUE_COUNT_MULTIPLE,SELF_ASK_CLARIFYING_QUESTIONS,Q_SAY_MORE_TO_CLARIFY_N,SELF_ASK_PAUSE,SELF_PAUSE_REFLECT,Q_PAUSE_UNDERSTAND_AND_EMPATHY_Y,SELF_REFLECT_ON_ISSUE,Q_INTERNAL_UNDERSTANDING_Y,SELF_RESTATE_ISSUE,Q_UNDERSTANDING_ISSUE_Y,Q_FEELING_EMPATHY_Y,Q_FEELING_EMPATHY_N,SELF_LACK_EMPATHY_ASK,Q_THEIR_IMPACT_STATEMENT_Y,Q_THEIR_IMPACT_STATEMENT_N,SELF_CREATE_SYNTHETIC_IMPACT_STATEMENT,Q_SYNTHETIC_IMPACT_STATEMENT_SHARE_Y,Q_SYNTHETIC_IMPACT_STATEMENT_SHARE_N,Q_SYNTHETIC_IMPACT_STATEMENT_ACCURACY_Y,Q_SYNTHETIC_IMPACT_STATEMENT_COUNT_MULTIPLE,Q_FEELING_REGRET_Y,SELF_FIND_NEW_PATTERN,SELF_EXPRESS_NEW_PATTERN,Q_PAUSE_REFLECT_COUNT_ONCE,Q_PAUSE_REFLECT_COUNT_MULTIPLE,Q_UNDERSTAND_IMPACT_Y,SELF_REFLECT_ON_IMPACT,Q_UNDERSTAND_PATTERNS_Y,SELF_REFLECT_ON_PAST_TIMES,Q_KNOW_NEW_PATTERN_Y,SELF_FOLLOW_UP forwards
