flowchart TD
  B_RAISE_ISSUE[Other side raises an issue]
  B_SELF_LISTEN["Me: Listen"]
  B_SELF_TAKE_NOTES["Me: take notes"]

  Q_THEM_DONE_SPEAKING{"in my head: are they done speaking"?}
  Q_CHOICE_THEM_DONE_SPEAKING_Y[Yes]
  Q_CHOICE_THEM_DONE_SPEAKING_N[No]

  Q_DO_I_UNDERSTAND_EVERYTHING_THEY_SAID{"Do I understand everything they said?"}
  Q_CHOICE_DO_I_UNDERSTAND_EVERYTHING_THEY_SAID_Y[Yes]
  Q_CHOICE_DO_I_UNDERSTAND_EVERYTHING_THEY_SAID_N[No]
  %% Q_ANYTHING_I_DO_NOT_UNDERSTAND{"in my head: is there anything said that I don't understand?"}
  %% Q_ANYTHING_I_DO_NOT_UNDERSTAND_Y[Yes]
  %% Q_ANYTHING_I_DO_NOT_UNDERSTAND_N[No]

  Q_CLARIFY_ISSUE_COUNT{"how many times have I asked them to clarify ___?"}
  Q_CHOICE_CLARIFY_ISSUE_COUNT_ONCE[Once]
  Q_CHOICE_CLARIFY_ISSUE_COUNT_NONE[I haven't yet]
  Q_CHOICE_CLARIFY_ISSUE_COUNT_MULTIPLE["more than once"]

  B_SELF_ASK_CLARIFYING_QUESTIONS["ask them: I want to understand ___ better. <br/> Can you say more?"]
  Q_SAY_MORE_TO_CLARIFY{"did they agree to say more?"}
  Q_CHOICE_SAY_MORE_TO_CLARIFY_Y[Yes]
  Q_CHOICE_SAY_MORE_TO_CLARIFY_N[No]

  B_SELF_ASK_PAUSE["ask them: 'Can we pause? I need time to think about this on my own.'"]
  Q_AGREE_TO_PAUSE{"did they agree to pause?"}
  Q_CHOICE_AGREE_TO_PAUSE_Y[Yes]
  Q_CHOICE_AGREE_TO_PAUSE_N[No]
  B_SELF_AGREE_LOOP_BACK_TIME["ask them: 'When can we come back to this?' and agree on a time"]
  B_SELF_PAUSE_REFLECT["Me: (alone) reflect on my notes and how my actions affected them"]
  Q_PAUSE_UNDERSTAND_AND_EMPATHY{"Me: ask self 'Do I understand their issue and feel genuine empathy?'"}
  Q_CHOICE_PAUSE_UNDERSTAND_AND_EMPATHY_Y[Yes]
  Q_CHOICE_PAUSE_UNDERSTAND_AND_EMPATHY_N[No]

  Q_PAUSE_REFLECT_COUNT{"how many times have I reflected alone?"}
  Q_CHOICE_PAUSE_REFLECT_COUNT_ONCE[Once]
  Q_CHOICE_PAUSE_REFLECT_COUNT_MULTIPLE["more than once"]

  B_SELF_REFLECT_ON_ISSUE["Me: (in my head) reflect on what they said and on my notes"]

  Q_INTERNAL_UNDERSTANDING{"Me: ask self 'Do I understand their issue enough to restate it to them'?"}
  Q_CHOICE_INTERNAL_UNDERSTANDING_Y[Yes]
  Q_CHOICE_INTERNAL_UNDERSTANDING_N[No]

  B_SELF_RESTATE_ISSUE["Me: read notes to them for confirmation of understanding"]
  
  B_SELF_ASK_IF_UNDERSTANDING_ISSUE_IS_CORRECT["ask them: 'Is my understanding correct?'"]
  Q_UNDERSTANDING_ISSUE{"What was their answer?"}
  Q_CHOICE_UNDERSTANDING_ISSUE_Y[Yes, it's correct]
  Q_CHOICE_UNDERSTANDING_ISSUE_N[No, it's wrong]
  
  B_GOAL_SELF_CHECK_EMPATHY[Me: Goal: Empathy]
  
  Q_FEELING_EMPATHY{"Me: ask self 'Do I feel genuine empathy?'"}
  Q_CHOICE_FEELING_EMPATHY_Y[Yes]
  Q_CHOICE_FEELING_EMPATHY_N[No]
  %% --> Q_DO_I_UNDERSTAND_THEIR_LOSS or a self-reflect path

%% TODO: add arrows for these
  Q_DO_I_UNDERSTAND_THEIR_LOSS{"Me: ask self 'Do I undersatnd the loss you suffered?'"}
Q_CHOICE_DO_I_UNDERSTAND_THEIR_LOSS_Y[Yes]
Q_CHOICE_DO_I_UNDERSTAND_THEIR_LOSS_N[No]
%% --> Q_HAVE_I_EXPERIENCED_SIMILAR_LOSS

%% TODO: add arrows for these
  Q_HAVE_I_EXPERIENCED_SIMILAR_LOSS{"Me: ask self 'Have I experienced a similar type of loss?'"}
Q_CHOICE_HAVE_I_EXPERIENCED_SIMILAR_LOSS_Y[Yes]
%% --> Q_DO_I_REMEMBER_MY_LOSS_FEELINGS
Q_CHOICE_HAVE_I_EXPERIENCED_SIMILAR_LOSS_N[No]
%% --> not sure yet
  
  Q_DO_I_REMEMBER_MY_LOSS_FEELINGS{"Me: ask self 'Do I remember the feelings I felt when I experienced my similar loss?'"}
Q_CHOICE_DO_I_REMEMBER_MY_LOSS_FEELINGS_Y[Yes]
%% --> remember them, reference them, then make a SIS
Q_CHOICE_DO_I_REMEMBER_MY_LOSS_FEELINGS_N[No]
%% --> not sure yet
  
  Q_EMPATHY_NO_COUNT{"how many times have I answered No to feeling empathy?"}
  Q_CHOICE_EMPATHY_NO_COUNT_ONCE[Once]
  Q_CHOICE_EMPATHY_NO_COUNT_MULTIPLE["more than once"]
  
  B_SELF_LACK_EMPATHY_ASK["Me: ask them for an impact statement"]
  
  Q_THEIR_IMPACT_STATEMENT{"Did they provide an impact statement"}
  Q_CHOICE_THEIR_IMPACT_STATEMENT_Y[Yes]
  Q_CHOICE_THEIR_IMPACT_STATEMENT_N[No]
  
  B_SELF_CREATE_SYNTHETIC_IMPACT_STATEMENT["self: draft my own impact statement of what they felt"]
  
  Q_SYNTHETIC_IMPACT_STATEMENT_SHARE{"Me: ask them: 'can I share how I think you felt?'"}
  Q_CHOICE_SYNTHETIC_IMPACT_STATEMENT_SHARE_Y[Yes]
  Q_CHOICE_SYNTHETIC_IMPACT_STATEMENT_SHARE_N[No]
  
  B_SELF_SYNTHETIC_IMPACT_STATEMENT_ACCURACY["Me: ask them 'Is my understanding of how you felt accurate'?"]
  Q_RESPONSE_TO_SYNTHETIC_IMPACT_STATEMENT_ACCURACY{"What was their answer to if my understanding was accurate?"}
  Q_CHOICE_RESPONSE_TO_SYNTHETIC_IMPACT_STATEMENT_ACCURACY_YES["It was accurate"]
  Q_CHOICE_RESPONSE_TO_SYNTHETIC_IMPACT_STATEMENT_ACCURACY_MISSED["Close but missed ___"]
  Q_CHOICE_RESPONSE_TO_SYNTHETIC_IMPACT_STATEMENT_ACCURACY_WRONG["wrong about ___"]
  Q_CHOICE_RESPONSE_TO_SYNTHETIC_IMPACT_STATEMENT_ACCURACY_NO["inaccurate"]
  %% Q_SYNTHETIC_IMPACT_STATEMENT_ACCURACY_Y[Yes]
  %% Q_SYNTHETIC_IMPACT_STATEMENT_ACCURACY_N[No]

  Q_SYNTHETIC_IMPACT_STATEMENT_COUNT{"how many times have I drafted an impact statement?"}
  Q_CHOICE_SYNTHETIC_IMPACT_STATEMENT_COUNT_ONCE[Once]
  Q_CHOICE_SYNTHETIC_IMPACT_STATEMENT_COUNT_MULTIPLE["more than once"]
  
  B_GOAL_SELF_CHECK_IMPACT[Me: Goal: Understand Impact]
  Q_UNDERSTAND_IMPACT{"Me: ask self 'Do I understand the hurt caused?'"}
  Q_CHOICE_UNDERSTAND_IMPACT_Y[Yes]
  Q_CHOICE_UNDERSTAND_IMPACT_N[No]
  B_SELF_REFLECT_ON_IMPACT["Me: reflect on their impact statement if I have it, or on my notes"]

  B_GOAL_SELF_CHECK_REGRET[Me: Goal: Feel Regret]
  
  Q_FEELING_REGRET{"Me: ask self 'Do I feel genuine regret?'"}
  Q_CHOICE_FEELING_REGRET_Y[Yes]
  Q_CHOICE_FEELING_REGRET_N[No]
  B_SELF_APOLOGIZE["Me: apologize"]
  Q_APOLOGY_ACCEPTED{"Did they accept the apology?"}
  Q_CHOICE_APOLOGY_ACCEPTED_Y[Yes]
  Q_CHOICE_APOLOGY_ACCEPTED_N[No]
  B_SELF_ASK_PAUSE_AFTER_APOLOGY["ask them: 'Can we pause? I need time to think about this on my own.'"]
  
  B_GOAL_SELF_SPOT_MY_PATTERNS[Me: Goal: Self-awareness]
  Q_UNDERSTAND_PATTERNS{"Me: ask self 'Do I understand my patterns?'"}
  Q_CHOICE_UNDERSTAND_PATTERNS_Y[Yes]
  Q_CHOICE_UNDERSTAND_PATTERNS_N[No]
  B_SELF_REFLECT_ON_PAST_TIMES["Me: reflect on past times this happened"]
  B_GOAL_SELF_CHECK_CHANGE[Me: Goal: Changed behavior]
  B_SELF_FIND_NEW_PATTERN["(in my head)What am I going to do differently"]
  Q_KNOW_NEW_PATTERN{"Me: ask self 'Do I know what I'll do differently?'"}
  Q_CHOICE_KNOW_NEW_PATTERN_Y[Yes]
  Q_CHOICE_KNOW_NEW_PATTERN_N[No]
  B_SELF_EXPRESS_NEW_PATTERN["Communicate: 'here is what I am going to do differently"]
  B_GOAL_SELF_CHECK_FOLLOW_UP[Me: Goal: Follow-up]
  B_SELF_FOLLOW_UP["(in the future) ask them: 'Hey, I wanted to check in about ___'"]

